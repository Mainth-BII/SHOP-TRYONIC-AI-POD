# Sao chép file này thành .env và điền credentials thật
# cp .env.example .env

# Email/password login (test account)
TEST_EMAIL=your_test_email@example.com
TEST_PASSWORD=YourTestPassword

# Alias cho test_daily_auth.py và test_daily_order.py
DAILY_TEST_EMAIL=your_test_email@example.com
DAILY_TEST_PASSWORD=YourTestPassword

# Gmail OAuth — cần set để chạy TC_044 đầy đủ (nếu không set → SKIP)
GOOGLE_TEST_EMAIL=your_google_account@gmail.com
GOOGLE_TEST_PASSWORD=YourGooglePassword
