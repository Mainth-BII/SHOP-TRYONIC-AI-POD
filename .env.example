# Sao chép file này thành .env và điền credentials thật
# cp .env.example .env

# ── Môi trường mặc định (test | prod) ───────────────────────────────────────
# CLI: pytest --env=test   hoặc   pytest --env=prod
# ENV: set TEST_ENV=prod
#
# Môi trường TEST:
#   FE:    https://test.shop.tryonic.ai
#   API:   https://api.test.shop.tryonic.ai
#   ADMIN: https://admin.test.shop.tryonic.ai
#
# Môi trường PROD:
#   FE:    https://shop.tryonic.ai
#   API:   https://api.shop.tryonic.ai
#   ADMIN: https://admin.shop.tryonic.ai
TEST_ENV=test

# ── Test account credentials ─────────────────────────────────────────────────
TEST_EMAIL=your_test_email@example.com
TEST_PASSWORD=YourTestPassword

DAILY_TEST_EMAIL=your_test_email@example.com
DAILY_TEST_PASSWORD=YourTestPassword

# Gmail OAuth — cần set để chạy TC_044 đầy đủ (nếu không set → SKIP)
GOOGLE_TEST_EMAIL=your_google_account@gmail.com
GOOGLE_TEST_PASSWORD=YourGooglePassword

# Admin panel credentials — dùng cho MH10 Admin verify
ADMIN_TEST_EMAIL=your_admin_email@example.com
ADMIN_TEST_PASSWORD=YourAdminPassword
